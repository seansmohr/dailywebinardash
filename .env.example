# ============================================================================
# The ONLY required variable is GHL_API_TOKEN. Everything else below is already
# baked in as a verified default for the Mohr Insurance sub-account — listed
# here so you can override if the GHL setup ever changes.
# ============================================================================

# ---- Required: GoHighLevel Private Integration token ----
# Sub-Account > Settings > Private Integrations > create a token with scopes:
#   contacts.readonly, locations/customFields.readonly, calendars.readonly,
#   calendars/events.readonly
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- Verified defaults (override only if the setup changes) ----
# GHL_LOCATION_ID=dTtT96ODx29mbQcdOp0v
# GHL_LP_FIELD_KEY=contact.landing_page          # "Landing Page" (id fTDU51m5BZslEG63pdfN)
# LP_CONTROL_VALUE=medicare101_landing_page_b
# LP_TEST_VALUE=medicare101_landing_page_daily
# LP_CONTROL_LABEL=Landing Page B (control)
# LP_TEST_LABEL=Daily (test)

# Attendance tags (comma-separated, case-insensitive):
# TAG_ATTENDED=attended webinar
# TAG_MISSED=missed webinar,no show

# Webinar-date field — attended/missed are placed on this date (the webinar day):
# GHL_WEBINAR_DATE_FIELD_KEY=contact.date__webinar_timedate
# How far before the window to also pull contacts so webinar-day/booking counts
# inside the window are complete (days):
# ATTENDANCE_LOOKBACK_DAYS=60
# BOOKING_FORWARD_DAYS=90

# Appointment calendars:
# CALENDAR_AUTOBOOK_ID=jDfKPflpQai5OB0v7m0C       # Turning 65 Medicare Call
# CALENDAR_VA_ID=iDBM1sRSqiZBWhblcGPD             # VA Calendar
# CALENDAR_AUTOBOOK_LABEL=Autobook (Turning 65)
# CALENDAR_VA_LABEL=VA Calendar

# Appointment statuses that DON'T count as a booking:
# APPT_EXCLUDE_STATUSES=cancelled

# ---- Dashboard behavior ----
# DASHBOARD_TZ=America/New_York                   # day-bucketing timezone
# CACHE_TTL_MS=60000                              # cache window per date range

# ---- Optional: protect the dashboard with HTTP Basic Auth (recommended) ----
# DASHBOARD_USER=team
DASHBOARD_PASSWORD=

# Railway sets PORT automatically; only set locally for a fixed port.
# PORT=3000
