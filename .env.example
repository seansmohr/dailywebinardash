# ---- Required: GoHighLevel Private Integration ----
# Sub-Account (Location) > Settings > Private Integrations > create a token with
# scopes: contacts.readonly, locations/customFields.readonly, calendars/events.readonly
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=your_location_id

# ---- Landing page custom field ----
# Matched (case-insensitively) against the field's fieldKey, name, or id.
# e.g. "landing_page", "contact.landing_page", or the raw field id.
GHL_LP_FIELD_KEY=landing_page
# The two values your landing pages write into that field:
LP_CONTROL_VALUE=medicare101_landing_page_b
LP_TEST_VALUE=medicare101_landing_page_daily
# Friendly labels shown in the UI (optional):
LP_CONTROL_LABEL=Landing Page B (control)
LP_TEST_LABEL=Daily (test)

# ---- Attendance tags (comma-separated, case-insensitive) ----
TAG_ATTENDED=attended
TAG_MISSED=missed,no-show,noshow

# ---- Appointment calendars ----
CALENDAR_AUTOBOOK_ID=your_autobook_calendar_id
CALENDAR_VA_ID=your_va_calendar_id
CALENDAR_AUTOBOOK_LABEL=Autobook
CALENDAR_VA_LABEL=VA Calendar

# ---- Dashboard behavior ----
# Timezone used to bucket everything into calendar days:
DASHBOARD_TZ=America/New_York
# Seconds-ish cache to shield GHL from refresh spam (milliseconds):
CACHE_TTL_MS=60000

# ---- Optional: protect the dashboard with HTTP Basic Auth ----
DASHBOARD_USER=team
DASHBOARD_PASSWORD=

# Railway sets PORT automatically; only set locally if you want a fixed port.
# PORT=3000
